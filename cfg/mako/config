# Mako notifications, styled to match the Hybuntu Waybar and Fuzzel theme.

# Placement
anchor=top-right
layer=overlay
width=360
height=180
outer-margin=12
margin=8
padding=14

# Appearance
font=Ubuntu 11
background-color=#111111F5
text-color=#E6E6E6FF
border-color=#3F3F46FF
border-size=1
border-radius=12
progress-color=over #33CCFFFF
icons=1
max-icon-size=48
markup=1
format=<b>%s</b>\n%b

# Behavior
sort=-time
max-visible=5
history=1
max-history=50
default-timeout=7000
ignore-timeout=0
actions=1

# Open the notification's default action with left click and dismiss it with
# either of the other mouse buttons.
on-button-left=invoke-default-action
on-button-middle=dismiss
on-button-right=dismiss

[urgency=low]
default-timeout=4000

[urgency=critical]
border-color=#FF6B6BFF
default-timeout=0
ignore-timeout=1

# Toggle this mode with: makoctl mode -t do-not-disturb
[mode=do-not-disturb]
invisible=1
